\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Expected qualitative outcomes of different sampling methods. Assumes Attraction and Repulsion forces are present at moderate, non-degenerate strengths.}}{14}{table.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:s1_sampling_expectations}{{1}{14}{Expected qualitative outcomes of different sampling methods. Assumes Attraction and Repulsion forces are present at moderate, non-degenerate strengths}{table.caption.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5}Results}{14}{section.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces  Real vs perceived group opinion means by sampling type and Repulsion learning rate (250 simulations each). Each point represents either the real or perceived group opinion mean within a single simulation; lines connect real and perceived group opinion means for each simulation. Violin plots show distributions for real and perceived means. }}{15}{figure.caption.2}\protected@file@percent }
\newlabel{fig:s1_fig1}{{1}{15}{Real vs perceived group opinion means by sampling type and Repulsion learning rate (250 simulations each). Each point represents either the real or perceived group opinion mean within a single simulation; lines connect real and perceived group opinion means for each simulation. Violin plots show distributions for real and perceived means}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces  Scatter plot of the signed discrepancy, $\Delta _g$, by group. Groups have been relabeled to their nearest poles to ensure simulations above and below the diagonal are interpretable. 250 simulations are plotted per parameter combination; points with open black borders denote simulation means across sampling type and $\gamma $. Quadrants of the plot correspond to qualitatively different intergroup misperceptions. Quadrant I corresponds to equal false polarization in both groups, Quadrant III corresponds to equal false moderation, and the remaining quadrants capture asymmetric cases in which one group is more accurate while the other is more inaccurate. }}{17}{figure.caption.3}\protected@file@percent }
\newlabel{fig:s1_500sims_sampling_scatter}{{2}{17}{Scatter plot of the signed discrepancy, $\Delta _g$, by group. Groups have been relabeled to their nearest poles to ensure simulations above and below the diagonal are interpretable. 250 simulations are plotted per parameter combination; points with open black borders denote simulation means across sampling type and $\gamma $. Quadrants of the plot correspond to qualitatively different intergroup misperceptions. Quadrant I corresponds to equal false polarization in both groups, Quadrant III corresponds to equal false moderation, and the remaining quadrants capture asymmetric cases in which one group is more accurate while the other is more inaccurate}{figure.caption.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}Robustness tests}{18}{subsection.5.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces  Single simulation plots of mean real and perceived group opinions over time, varying perception initialization method and sampling type. Qualitative differences in dynamics are clear across perception initialization methods, showing a sensitivity to initial conditions. All other parameters were held constant between simulations: $\alpha = 0.4$, $\gamma = 1.0$, $\beta = \eta = 2.0$. }}{19}{figure.caption.4}\protected@file@percent }
\newlabel{fig:s1_sim_example_sampling_initrand}{{3}{19}{Single simulation plots of mean real and perceived group opinions over time, varying perception initialization method and sampling type. Qualitative differences in dynamics are clear across perception initialization methods, showing a sensitivity to initial conditions. All other parameters were held constant between simulations: $\alpha = 0.4$, $\gamma = 1.0$, $\beta = \eta = 2.0$}{figure.caption.4}{}}
